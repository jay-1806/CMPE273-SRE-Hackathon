# Application Configuration
APP_NAME=SRE Tier-0 Monitoring Dashboard
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Set to "false" to use in-memory dict instead of Redis
USE_REDIS=true

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=iot/devices

# Cohere AI Configuration
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command-r-plus

# IoT Device Simulation
NUM_SITES=10
DEVICES_PER_SITE=10000
TOTAL_DEVICES=100000
DEVICE_TYPES=Turbine,ThermalEngine,ElectricalRotor,OilAndGas

# Regions for Failover
PRIMARY_REGION=region1
SECONDARY_REGION=region2
FAILOVER_THRESHOLD_MS=5000

# Monitoring Configuration
METRICS_INTERVAL_SECONDS=5
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Frontend Configuration
FRONTEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api

# Database (if needed for future expansion)
# DATABASE_URL=postgresql://user:password@localhost/sre_dashboard

# Logging
LOG_FILE_PATH=data/logs/app.log
SAMPLE_LOG_PATH=sample_log.txt
